{% doc %}
  @prompt
    Create a product listing section that displays all products in a grid layout matching the existing site theme — blush-pink, rose, and gold soft-luxury aesthetic. The section should show product images, titles, and prices in a responsive grid, styled consistently with the current theme's fonts, colors, and card styles., add all products not only collection , use the same theme as the website 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-product-grid-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: {{ block.settings.section_padding_top }}px 20px {{ block.settings.section_padding_bottom }}px;
    background-color: {{ settings.color_body_bg }};
  }

  .ai-product-grid-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
  }

  .ai-product-grid-header-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: {{ block.settings.header_spacing }}px;
  }

  .ai-product-grid-title-{{ ai_gen_id }} {
    font-family: {{ settings.type_header_font_family.family }}, {{ settings.type_header_font_family.fallback_families }};
    font-weight: {{ settings.type_header_font_family.weight }};
    font-style: {{ settings.type_header_font_family.style }};
    font-size: {{ settings.type_header_base_size }}px;
    line-height: {{ settings.type_header_line_height }};
    color: {{ settings.color_body_text }};
    margin: 0 0 12px;
    {% if settings.type_header_capitalize %}
      text-transform: uppercase;
    {% endif %}
    letter-spacing: {{ settings.type_header_spacing | divided_by: 100.0 }}em;
  }

  .ai-product-grid-description-{{ ai_gen_id }} {
    font-family: {{ settings.type_base_font_family.family }}, {{ settings.type_base_font_family.fallback_families }};
    font-weight: {{ settings.type_base_font_family.weight }};
    font-style: {{ settings.type_base_font_family.style }};
    font-size: {{ settings.type_base_size }}px;
    line-height: {{ settings.type_base_line_height }};
    color: {{ settings.color_body_text }};
    max-width: 700px;
    margin: 0 auto;
  }

  .ai-product-grid-items-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat({{ block.settings.columns_desktop }}, 1fr);
    gap: {{ block.settings.grid_gap }}px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .ai-product-card-{{ ai_gen_id }} {
    position: relative;
    display: flex;
    flex-direction: column;
    background-color: {{ settings.color_small_image_bg }};
    border-radius: {{ block.settings.card_border_radius }}px;
    overflow: hidden;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .ai-product-card-{{ ai_gen_id }}:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 24px rgba(212, 187, 168, 0.3);
  }

  .ai-product-card-link-{{ ai_gen_id }} {
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .ai-product-image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    padding-bottom: {{ block.settings.image_aspect_ratio }}%;
    background-color: {{ settings.color_small_image_bg }};
    overflow: hidden;
  }

  .ai-product-image-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .ai-product-card-{{ ai_gen_id }}:hover .ai-product-image-{{ ai_gen_id }} {
    transform: scale(1.05);
  }

  .ai-product-badge-{{ ai_gen_id }} {
    position: absolute;
    top: 12px;
    left: 12px;
    background-color: {{ settings.color_sale_tag }};
    color: {{ settings.color_sale_tag_text }};
    padding: 6px 12px;
    border-radius: {{ block.settings.badge_border_radius }}px;
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    z-index: 2;
  }

  .ai-product-info-{{ ai_gen_id }} {
    padding: {{ block.settings.card_padding }}px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    flex-grow: 1;
  }

  .ai-product-vendor-{{ ai_gen_id }} {
    font-family: {{ settings.type_base_font_family.family }}, {{ settings.type_base_font_family.fallback_families }};
    font-size: 12px;
    color: {{ settings.color_savings_text }};
    text-transform: uppercase;
    letter-spacing: 1px;
    margin: 0;
  }

  .ai-product-title-{{ ai_gen_id }} {
    font-family: {{ settings.type_base_font_family.family }}, {{ settings.type_base_font_family.fallback_families }};
    font-weight: {{ settings.type_base_font_family.weight }};
    font-size: {{ settings.type_collection_size }}px;
    line-height: 1.3;
    color: {{ settings.color_body_text }};
    margin: 0;
    {% if settings.type_product_capitalize %}
      text-transform: uppercase;
    {% endif %}
  }

  .ai-product-price-{{ ai_gen_id }} {
    font-family: {{ settings.type_base_font_family.family }}, {{ settings.type_base_font_family.fallback_families }};
    font-size: {{ settings.type_base_size }}px;
    color: {{ settings.color_price }};
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }

  .ai-product-price-regular-{{ ai_gen_id }} {
    font-weight: 600;
  }

  .ai-product-price-compare-{{ ai_gen_id }} {
    text-decoration: line-through;
    opacity: 0.6;
    font-size: 0.9em;
  }

  .ai-product-price-save-{{ ai_gen_id }} {
    color: {{ settings.color_savings_text }};
    font-size: 0.85em;
    font-weight: 600;
  }

  .ai-product-empty-state-{{ ai_gen_id }} {
    text-align: center;
    padding: 60px 20px;
    color: {{ settings.color_body_text }};
  }

  .ai-product-empty-state-{{ ai_gen_id }} h3 {
    font-family: {{ settings.type_header_font_family.family }}, {{ settings.type_header_font_family.fallback_families }};
    font-size: 24px;
    margin: 0 0 12px;
    color: {{ settings.color_body_text }};
  }

  .ai-product-empty-state-{{ ai_gen_id }} p {
    font-family: {{ settings.type_base_font_family.family }}, {{ settings.type_base_font_family.fallback_families }};
    font-size: 16px;
    margin: 0;
    opacity: 0.7;
  }

  @media screen and (max-width: 989px) {
    .ai-product-grid-items-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_tablet }}, 1fr);
    }

    .ai-product-grid-title-{{ ai_gen_id }} {
      font-size: {{ settings.type_header_base_size | times: 0.8 }}px;
    }
  }

  @media screen and (max-width: 749px) {
    .ai-product-grid-items-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_mobile }}, 1fr);
      gap: {{ block.settings.grid_gap | times: 0.7 }}px;
    }

    .ai-product-grid-{{ ai_gen_id }} {
      padding: {{ block.settings.section_padding_top | times: 0.6 }}px 16px {{ block.settings.section_padding_bottom | times: 0.6 }}px;
    }

    .ai-product-grid-title-{{ ai_gen_id }} {
      font-size: {{ settings.type_header_base_size | times: 0.7 }}px;
    }

    .ai-product-info-{{ ai_gen_id }} {
      padding: {{ block.settings.card_padding | times: 0.8 }}px;
    }
  }
{% endstyle %}

<product-grid-{{ ai_gen_id }} class="ai-product-grid-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-product-grid-container-{{ ai_gen_id }}">
    {% if block.settings.heading != blank or block.settings.description != blank %}
      <div class="ai-product-grid-header-{{ ai_gen_id }}">
        {% if block.settings.heading != blank %}
          <h2 class="ai-product-grid-title-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
        {% endif %}
        {% if block.settings.description != blank %}
          <div class="ai-product-grid-description-{{ ai_gen_id }}">{{ block.settings.description }}</div>
        {% endif %}
      </div>
    {% endif %}

    {% liquid
      if block.settings.product_source == 'collection' and block.settings.collection != blank
        assign products_list = block.settings.collection.products
      else
        assign products_list = collections.all.products
      endif
      assign products_to_show = block.settings.products_to_show
    %}
    
    {% if products_list.size > 0 %}
      <ul class="ai-product-grid-items-{{ ai_gen_id }}">
        {% for product in products_list limit: products_to_show %}
          <li class="ai-product-card-{{ ai_gen_id }}">
            <a href="{{ product.url }}" class="ai-product-card-link-{{ ai_gen_id }}">
              <div class="ai-product-image-wrapper-{{ ai_gen_id }}">
                {% if product.featured_image %}
                  <img
                    src="{{ product.featured_image | image_url: width: 800 }}"
                    alt="{{ product.featured_image.alt | escape }}"
                    loading="lazy"
                    width="800"
                    height="{{ 800 | times: block.settings.image_aspect_ratio | divided_by: 100.0 | round }}"
                    class="ai-product-image-{{ ai_gen_id }}"
                  >
                {% else %}
                  <div class="ai-product-image-placeholder-{{ ai_gen_id }}">
                    {{ 'product-1' | placeholder_svg_tag }}
                  </div>
                {% endif %}

                {% if product.compare_at_price > product.price and block.settings.show_sale_badge %}
                  <span class="ai-product-badge-{{ ai_gen_id }}">{{ block.settings.sale_badge_text }}</span>
                {% endif %}
              </div>

              <div class="ai-product-info-{{ ai_gen_id }}">
                {% if block.settings.show_vendor and product.vendor != blank %}
                  <p class="ai-product-vendor-{{ ai_gen_id }}">{{ product.vendor }}</p>
                {% endif %}

                <h3 class="ai-product-title-{{ ai_gen_id }}">{{ product.title }}</h3>

                <div class="ai-product-price-{{ ai_gen_id }}">
                  {% if product.compare_at_price > product.price %}
                    <span class="ai-product-price-regular-{{ ai_gen_id }}">{{ product.price | money }}</span>
                    <span class="ai-product-price-compare-{{ ai_gen_id }}">{{ product.compare_at_price | money }}</span>
                    {% if block.settings.show_savings %}
                      {% assign savings = product.compare_at_price | minus: product.price %}
                      <span class="ai-product-price-save-{{ ai_gen_id }}">Save {{ savings | money }}</span>
                    {% endif %}
                  {% else %}
                    <span class="ai-product-price-regular-{{ ai_gen_id }}">{{ product.price | money }}</span>
                  {% endif %}
                </div>
              </div>
            </a>
          </li>
        {% endfor %}
      </ul>
    {% else %}
      <div class="ai-product-empty-state-{{ ai_gen_id }}">
        <h3>No products found</h3>
        <p>Add products to your store to display them here.</p>
      </div>
    {% endif %}
  </div>
</product-grid-{{ ai_gen_id }}>

<script>
  (function() {
    class ProductGrid{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.initializeGrid();
      }

      initializeGrid() {
        const cards = this.querySelectorAll('.ai-product-card-{{ ai_gen_id }}');
        
        cards.forEach((card, index) => {
          card.style.opacity = '0';
          card.style.transform = 'translateY(20px)';
          
          setTimeout(() => {
            card.style.transition = 'opacity 0.5s ease, transform 0.5s ease';
            card.style.opacity = '1';
            card.style.transform = 'translateY(0)';
          }, index * 50);
        });
      }
    }

    customElements.define('product-grid-{{ ai_gen_id }}', ProductGrid{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Product grid",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Shop all products"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Discover our curated selection of premium press-on nails</p>"
    },
    {
      "type": "select",
      "id": "product_source",
      "label": "Product source",
      "options": [
        {
          "value": "all",
          "label": "All products"
        },
        {
          "value": "collection",
          "label": "Specific collection"
        }
      ],
      "default": "all"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 2,
      "max": 50,
      "step": 1,
      "default": 12
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Columns on desktop",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4
    },
    {
      "type": "select",
      "id": "columns_tablet",
      "label": "Columns on tablet",
      "options": [
        {
          "value": "2",
          "label": "2"
        },
        {
          "value": "3",
          "label": "3"
        }
      ],
      "default": "3"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Columns on mobile",
      "options": [
        {
          "value": "1",
          "label": "1"
        },
        {
          "value": "2",
          "label": "2"
        }
      ],
      "default": "2"
    },
    {
      "type": "range",
      "id": "grid_gap",
      "label": "Grid gap",
      "min": 10,
      "max": 60,
      "step": 5,
      "unit": "px",
      "default": 30
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Maximum width",
      "min": 1000,
      "max": 1600,
      "step": 50,
      "unit": "px",
      "default": 1400
    },
    {
      "type": "header",
      "content": "Product cards"
    },
    {
      "type": "range",
      "id": "image_aspect_ratio",
      "label": "Image aspect ratio",
      "min": 75,
      "max": 150,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "card_padding",
      "label": "Card padding",
      "min": 10,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "card_border_radius",
      "label": "Card border radius",
      "min": 0,
      "max": 30,
      "step": 2,
      "unit": "px",
      "default": 8
    },
    {
      "type": "header",
      "content": "Product information"
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Show vendor",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_sale_badge",
      "label": "Show sale badge",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_savings",
      "label": "Show savings amount",
      "default": true
    },
    {
      "type": "inline_richtext",
      "id": "sale_badge_text",
      "label": "Sale badge text",
      "default": "Sale"
    },
    {
      "type": "range",
      "id": "badge_border_radius",
      "label": "Badge border radius",
      "min": 0,
      "max": 20,
      "step": 2,
      "unit": "px",
      "default": 4
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "header_spacing",
      "label": "Header spacing",
      "min": 20,
      "max": 80,
      "step": 5,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "section_padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "section_padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 60
    }
  ],
  "presets": [
    {
      "name": "Product grid"
    }
  ]
}
{% endschema %}
