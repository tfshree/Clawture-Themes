{% doc %}
  @prompt
    Create a product listing section that displays ALL products from the store (not a specific collection) in a responsive grid layout.
    
    DESIGN & AESTHETIC:
    - Match a blush-pink, rose, and gold soft-luxury feminine aesthetic
    - Use the theme's existing fonts, colors, and card styles
    - Product cards with soft rounded corners, subtle box shadows, and hover effects (gentle lift/scale)
    - SALE badge in rose/gold styling when product is on sale
    - Blush-pink background tones with gold accent borders or highlights
    - Elegant typography matching the theme
    
    PRODUCT CARD CONTENT:
    - Product image (with aspect ratio preserved, object-fit cover)
    - Product title in theme font
    - Price display: show sale price + compare-at price (strikethrough) when on sale, and "Save Rs. X" savings label
    - Subtle hover overlay or card lift effect
    
    GRID LAYOUT:
    - Responsive: 4 columns on desktop, 2 on tablet, 2 on mobile
    - Consistent card heights with image top, content bottom
    
    LOAD MORE FUNCTIONALITY:
    - Initially display 12 products
    - "Load More" button below the grid in rose/gold styling
    - On click, load the next 12 products via JavaScript using Shopify's section rendering API with pagination
    - Hide "Load More" button when all products are loaded
    - Smooth fade-in animation for newly loaded products
    
    SECTION SETTINGS (in schema):
    - Section heading (e.g. "All Products")
    - Products per page (default 12)
    - Number of columns on desktop (2, 3, or 4)
    
    Use Liquid to render the initial 12 products using paginate with collections.all. Use JavaScript fetch with Shopify's section rendering API for load more pagination. Make it a standalone .liquid section file addable to any page template., the product images are not there , change the colour to websites theme and whenever user will reload website randomize the products , change the colour to websites theme , randomize the product whenever user will reload the page , add subheading too 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% assign all_products = collections.all.products %}
{% assign product_count = all_products.size %}
{% assign seed = 'now' | date: '%s' %}

{% style %}
  .ai-all-products-section-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: 60px 20px;
    background-color: {{ settings.color_body_bg }};
  }

  .ai-all-products-container-{{ ai_gen_id }} {
    max-width: 1400px;
    margin: 0 auto;
  }

  .ai-all-products-header-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: 50px;
  }

  .ai-all-products-heading-{{ ai_gen_id }} {
    margin: 0 0 12px;
    font-family: {{ settings.type_header_font_family.family }}, {{ settings.type_header_font_family.fallback_families }};
    font-weight: {{ settings.type_header_font_family.weight }};
    font-size: {{ settings.type_header_base_size }}px;
    line-height: {{ settings.type_header_line_height }};
    color: {{ settings.color_body_text }};
    {% if settings.type_header_capitalize %}
      text-transform: uppercase;
    {% endif %}
    letter-spacing: {{ settings.type_header_spacing | divided_by: 100.0 }}em;
  }

  .ai-all-products-subheading-{{ ai_gen_id }} {
    margin: 0;
    font-family: {{ settings.type_base_font_family.family }}, {{ settings.type_base_font_family.fallback_families }};
    font-weight: {{ settings.type_base_font_family.weight }};
    font-size: calc({{ settings.type_base_size }}px * 1.1);
    line-height: {{ settings.type_base_line_height }};
    color: {{ settings.color_body_text }};
    opacity: 0.7;
  }

  .ai-all-products-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat({{ block.settings.columns_desktop }}, 1fr);
    gap: 30px;
    margin-bottom: 40px;
  }

  .ai-product-card-{{ ai_gen_id }} {
    background: {{ settings.color_small_image_bg }};
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 2px 8px rgba(196, 168, 130, 0.1);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    opacity: 0;
    animation: ai-fade-in-{{ ai_gen_id }} 0.5s ease forwards;
  }

  .ai-product-card-{{ ai_gen_id }}:hover {
    transform: translateY(-8px);
    box-shadow: 0 8px 20px rgba(196, 168, 130, 0.2);
  }

  @keyframes ai-fade-in-{{ ai_gen_id }} {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .ai-product-card-image-wrapper-{{ ai_gen_id }} {
    position: relative;
    display: block;
    width: 100%;
    padding-bottom: 100%;
    overflow: hidden;
    background: {{ settings.color_small_image_bg }};
  }

  .ai-product-card-image-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .ai-product-card-{{ ai_gen_id }}:hover .ai-product-card-image-{{ ai_gen_id }} {
    transform: scale(1.05);
  }

  .ai-product-image-placeholder-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: {{ settings.color_small_image_bg }};
  }

  .ai-product-image-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-product-sale-badge-{{ ai_gen_id }} {
    position: absolute;
    top: 12px;
    right: 12px;
    background: {{ settings.color_sale_tag }};
    color: {{ settings.color_sale_tag_text }};
    padding: 6px 12px;
    border-radius: 20px;
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    border: 1px solid {{ settings.color_savings_text }};
    z-index: 2;
  }

  .ai-product-card-content-{{ ai_gen_id }} {
    padding: 20px;
  }

  .ai-product-card-title-{{ ai_gen_id }} {
    margin: 0 0 12px;
    font-family: {{ settings.type_base_font_family.family }}, {{ settings.type_base_font_family.fallback_families }};
    font-weight: {{ settings.type_base_font_family.weight }};
    font-size: {{ settings.type_base_size }}px;
    line-height: {{ settings.type_base_line_height }};
    color: {{ settings.color_body_text }};
    {% if settings.type_product_capitalize %}
      text-transform: uppercase;
    {% endif %}
  }

  .ai-product-card-title-link-{{ ai_gen_id }} {
    color: inherit;
    text-decoration: none;
  }

  .ai-product-card-title-link-{{ ai_gen_id }}:hover {
    color: {{ settings.color_savings_text }};
  }

  .ai-product-card-price-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
    margin-bottom: 8px;
  }

  .ai-product-price-current-{{ ai_gen_id }} {
    font-size: 18px;
    font-weight: 600;
    color: {{ settings.color_price }};
  }

  .ai-product-price-compare-{{ ai_gen_id }} {
    font-size: 16px;
    color: {{ settings.color_body_text }};
    opacity: 0.5;
    text-decoration: line-through;
  }

  .ai-product-savings-{{ ai_gen_id }} {
    font-size: 13px;
    color: {{ settings.color_savings_text }};
    font-weight: 600;
  }

  .ai-load-more-wrapper-{{ ai_gen_id }} {
    text-align: center;
    margin-top: 40px;
  }

  .ai-load-more-button-{{ ai_gen_id }} {
    display: inline-block;
    padding: 14px 40px;
    background: {{ settings.color_button }};
    color: {{ settings.color_button_text }};
    border: 2px solid {{ settings.color_borders }};
    border-radius: 4px;
    font-family: {{ settings.type_base_font_family.family }}, {{ settings.type_base_font_family.fallback_families }};
    font-size: 16px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 1px;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .ai-load-more-button-{{ ai_gen_id }}:hover {
    background: {{ settings.color_savings_text }};
    color: {{ settings.color_button_text }};
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(196, 168, 130, 0.3);
  }

  .ai-load-more-button-{{ ai_gen_id }}:disabled {
    opacity: 0.5;
    cursor: not-allowed;
    transform: none;
  }

  .ai-load-more-button-{{ ai_gen_id }}.hidden {
    display: none;
  }

  @media screen and (max-width: 989px) {
    .ai-all-products-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat(2, 1fr);
      gap: 20px;
    }

    .ai-all-products-section-{{ ai_gen_id }} {
      padding: 40px 15px;
    }

    .ai-all-products-heading-{{ ai_gen_id }} {
      font-size: calc({{ settings.type_header_base_size }}px * 0.8);
    }

    .ai-all-products-subheading-{{ ai_gen_id }} {
      font-size: calc({{ settings.type_base_size }}px * 1);
    }

    .ai-all-products-header-{{ ai_gen_id }} {
      margin-bottom: 30px;
    }

    .ai-product-card-content-{{ ai_gen_id }} {
      padding: 15px;
    }

    .ai-product-card-title-{{ ai_gen_id }} {
      font-size: calc({{ settings.type_base_size }}px * 0.9);
    }

    .ai-product-price-current-{{ ai_gen_id }} {
      font-size: 16px;
    }

    .ai-product-price-compare-{{ ai_gen_id }} {
      font-size: 14px;
    }
  }

  @media screen and (max-width: 749px) {
    .ai-all-products-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat(2, 1fr);
      gap: 15px;
    }
  }
{% endstyle %}

<all-products-section-{{ ai_gen_id }}
  class="ai-all-products-section-{{ ai_gen_id }}"
  data-products-per-page="{{ block.settings.products_per_page }}"
  data-seed="{{ seed }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-all-products-container-{{ ai_gen_id }}">
    <div class="ai-all-products-header-{{ ai_gen_id }}">
      {% if block.settings.section_heading != blank %}
        <h2 class="ai-all-products-heading-{{ ai_gen_id }}">{{ block.settings.section_heading }}</h2>
      {% endif %}
      {% if block.settings.section_subheading != blank %}
        <p class="ai-all-products-subheading-{{ ai_gen_id }}">{{ block.settings.section_subheading }}</p>
      {% endif %}
    </div>

    <div class="ai-all-products-grid-{{ ai_gen_id }}" id="ai-products-grid-{{ ai_gen_id }}" data-all-products='{{ all_products | json | escape }}'>
    </div>

    <div class="ai-load-more-wrapper-{{ ai_gen_id }}">
      <button
        class="ai-load-more-button-{{ ai_gen_id }}"
        id="ai-load-more-{{ ai_gen_id }}"
        aria-label="Load more products"
      >
        Load More
      </button>
    </div>
  </div>
</all-products-section-{{ ai_gen_id }}>

<script>
  (function() {
    class AllProductsSection{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.loadMoreButton = this.querySelector('#ai-load-more-{{ ai_gen_id }}');
        this.productsGrid = this.querySelector('#ai-products-grid-{{ ai_gen_id }}');
        this.productsPerPage = parseInt(this.dataset.productsPerPage);
        this.currentPage = 0;
        this.allProducts = [];
        this.shuffledProducts = [];
      }

      connectedCallback() {
        this.loadProducts();
        this.loadMoreButton.addEventListener('click', () => this.loadMoreProducts());
      }

      loadProducts() {
        try {
          const productsData = this.productsGrid.dataset.allProducts;
          this.allProducts = JSON.parse(productsData);
          this.shuffledProducts = this.shuffleArray([...this.allProducts]);
          this.renderProducts();
        } catch (error) {
          console.error('Error loading products:', error);
        }
      }

      shuffleArray(array) {
        const seed = parseInt(this.dataset.seed);
        let currentIndex = array.length;
        let randomValue = seed;

        const seededRandom = () => {
          randomValue = (randomValue * 9301 + 49297) % 233280;
          return randomValue / 233280;
        };

        while (currentIndex !== 0) {
          const randomIndex = Math.floor(seededRandom() * currentIndex);
          currentIndex--;
          [array[currentIndex], array[randomIndex]] = [array[randomIndex], array[currentIndex]];
        }

        return array;
      }

      renderProducts() {
        const start = this.currentPage * this.productsPerPage;
        const end = start + this.productsPerPage;
        const productsToShow = this.shuffledProducts.slice(start, end);

        productsToShow.forEach((product, index) => {
          const productCard = this.createProductCard(product, index);
          this.productsGrid.appendChild(productCard);
        });

        this.currentPage++;

        if (end >= this.shuffledProducts.length) {
          this.loadMoreButton.classList.add('hidden');
        }
      }

      createProductCard(product, index) {
        const card = document.createElement('div');
        card.className = 'ai-product-card-{{ ai_gen_id }}';
        card.style.animationDelay = `${index * 0.05}s`;

        const hasImage = product.featured_image;
        const imageUrl = hasImage ? product.featured_image.replace(/\.(jpg|jpeg|png|gif|webp)/i, '_600x.$1') : '';
        const imageAlt = product.featured_image_alt || product.title;

        const isOnSale = product.compare_at_price && product.compare_at_price > product.price;
        const savings = isOnSale ? product.compare_at_price - product.price : 0;

        card.innerHTML = `
          <a href="${product.url}" class="ai-product-card-image-wrapper-{{ ai_gen_id }}">
            ${hasImage ? `
              <img
                src="${imageUrl}"
                alt="${this.escapeHtml(imageAlt)}"
                class="ai-product-card-image-{{ ai_gen_id }}"
                loading="lazy"
                width="600"
                height="600"
              >
            ` : `
              <div class="ai-product-image-placeholder-{{ ai_gen_id }}">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 525.5 525.5">
                  <path d="M324.5 212.7H203c-1.6 0-2.8 1.3-2.8 2.8V308c0 1.6 1.3 2.8 2.8 2.8h121.6c1.6 0 2.8-1.3 2.8-2.8v-92.5c0-1.6-1.3-2.8-2.9-2.8zm1.1 95.3c0 .6-.5 1.1-1.1 1.1H203c-.6 0-1.1-.5-1.1-1.1v-92.5c0-.6.5-1.1 1.1-1.1h121.6c.6 0 1.1.5 1.1 1.1V308z"/>
                  <path d="M210.4 299.5H240v.1s.1 0 .2-.1h75.2v-76.2h-105v76.2zm1.8-7.2l20-24c1.6-1.9 4.3-2.1 6.2-.6l12.6 10.3 20.2-24.2c1.5-1.8 4.1-2 5.9-.6l18 15.3v-26.8h-82.9v50.6z"/>
                  <circle cx="227.7" cy="244.4" r="5.4"/>
                </svg>
              </div>
            `}
            ${isOnSale ? '<span class="ai-product-sale-badge-{{ ai_gen_id }}">Sale</span>' : ''}
          </a>
          <div class="ai-product-card-content-{{ ai_gen_id }}">
            <h3 class="ai-product-card-title-{{ ai_gen_id }}">
              <a href="${product.url}" class="ai-product-card-title-link-{{ ai_gen_id }}">
                ${this.escapeHtml(product.title)}
              </a>
            </h3>
            <div class="ai-product-card-price-{{ ai_gen_id }}">
              <span class="ai-product-price-current-{{ ai_gen_id }}">
                ${this.formatMoney(product.price)}
              </span>
              ${isOnSale ? `
                <span class="ai-product-price-compare-{{ ai_gen_id }}">
                  ${this.formatMoney(product.compare_at_price)}
                </span>
                <span class="ai-product-savings-{{ ai_gen_id }}">
                  Save ${this.formatMoney(savings)}
                </span>
              ` : ''}
            </div>
          </div>
        `;

        return card;
      }

      loadMoreProducts() {
        this.renderProducts();
      }

      formatMoney(cents) {
        const amount = cents / 100;
        return '₹' + amount.toFixed(2);
      }

      escapeHtml(text) {
        const div = document.createElement('div');
        div.textContent = text;
        return div.innerHTML;
      }
    }

    customElements.define('all-products-section-{{ ai_gen_id }}', AllProductsSection{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "All products grid",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Section"
    },
    {
      "type": "text",
      "id": "section_heading",
      "label": "Heading",
      "default": "All Products"
    },
    {
      "type": "text",
      "id": "section_subheading",
      "label": "Subheading",
      "default": "Discover our complete collection"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "products_per_page",
      "label": "Products per page",
      "min": 8,
      "max": 24,
      "step": 4,
      "default": 12
    },
    {
      "type": "select",
      "id": "columns_desktop",
      "label": "Columns on desktop",
      "options": [
        {
          "value": "2",
          "label": "2"
        },
        {
          "value": "3",
          "label": "3"
        },
        {
          "value": "4",
          "label": "4"
        }
      ],
      "default": "4"
    }
  ],
  "presets": [
    {
      "name": "All products grid"
    }
  ]
}
{% endschema %}